# Copy this file to .env and adjust only the values you need to override.
GATEWAY_BIND_IP=0.0.0.0

# Let's Encrypt account contact. Copy this file to .env and replace it.
TRAEFIK_ACME_EMAIL=admin@example.invalid

# Production is the default. During repeated setup tests, uncomment staging to
# avoid Let's Encrypt production rate limits. Staging certificates are untrusted.
# TRAEFIK_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# TRAEFIK_CERTIFICATES_VOLUME=onprem-relay-traefik-certificates-staging

# Pin the gateway image.
TRAEFIK_IMAGE=traefik:v3.7.1
