# Copy this file to .env and replace the example hostnames.
GATEWAY_BIND_IP=0.0.0.0

MINECRAFT_VANILLA_HOST=minecraft.example.mydns.jp
MINECRAFT_VANILLA_HOST_PORT=41409

# Use a hyphen instead of an underscore in a hostname.
MINECRAFT_HARDCORE_HOST=minecraft-hardcore.example.mydns.jp
MINECRAFT_HARDCORE_HOST_PORT=41411

# Pin the generic gateway image. mc-router currently publishes a rolling latest tag.
TRAEFIK_IMAGE=traefik:v3.7.1
MC_ROUTER_IMAGE=itzg/mc-router:latest
