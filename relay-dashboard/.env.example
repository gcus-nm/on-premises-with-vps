# The dashboard uses HTTP Basic authentication. Use a unique random password
# of at least 16 characters. This file is loaded by Docker Compose.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Keep 127.0.0.1 unless the dashboard must be opened from another WireGuard
# peer. When using 0.0.0.0, restrict Windows Firewall to the WireGuard subnet.
RELAY_DASHBOARD_BIND_IP=127.0.0.1
RELAY_DASHBOARD_PORT=41800

# SSH alias inside relay-dashboard/secrets/ssh/config.
RELAY_SSH_HOST=oci-relay
RELAY_NETWORK=10.99.0.0/24
RELAY_ADDRESS=10.99.0.1
